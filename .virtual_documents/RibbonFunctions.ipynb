from jupyterexcel import ribbon_function
from jupyterexcel.action_examples import group_sum_by_color
 
debug_cache={}
@ribbon_function(
    name="SUM.GROUP.BY.COLOR",
    label="Sum Group by Color",
    button_text="Calculate",
    description="Group numeric cells by manual fill color. Text, blanks and booleans are ignored; hidden cells are included.",
    inputs={
        "data": {"source": "range", "type": "matrix", "label": "Data range",
                 "read": ["values", "format.fillColors"], "max_cells": 5000}
    },
    output={"type": "matrix", "destinations": "range"},
)
def sum_group_by_color(data):
    if 'debug_map' not in globals():
        globals()["debug_map"]={}
    debug_map ['color'] = data
    
    r= group_sum_by_color(data)
    debug_map ['color_r'] = r
    return r



import random, math
from datetime import date, datetime, timedelta


@ribbon_function(
    name="QUERY.PRICE.DATA",
    label="Query Price Data",
    button_text="Generate",
    description="Generate 100 rows of simulated weekday prices.",
    inputs={
        "ticker": {
            "source": "value",
            "type": "string",
            "label": "Ticker",
            "default": "MSFT",
        },
        "d": {
            "source": "value",
            "type": "string",
            "label": "Starting date (YYYY-MM-DD)",
            "default": "2026-09-01",
        },
    },
    output={"type": "matrix", "destinations": "range"},
)
def queryPriceData(ticker, d):
    if isinstance(d, str):
        d = date.fromisoformat(d)
    elif isinstance(d, datetime):
        d = d.date()

    r = []
    r.append(['Date', 'Open', 'Low', 'High', 'Close'])
    (p, expected_return,annual_vol) =( 500.0, 0.05, 0.3)
    daily_return = expected_return / 252
    daily_vol = annual_vol / 252**0.5  
    
    while len(r) < 100:
        if d.weekday() < 5:
            close =  p * math.exp( daily_return -0.5 *  daily_vol ** 2  + daily_vol * random.gauss(0, 1) )
            low = close * ( 1 - random.gauss(0, 1) * daily_vol * 0.5 )
            high = close* ( 1 + random.gauss(0, 1) * daily_vol * 0.5 )

            r.append([
                d.isoformat(),
                round(p, 2), 
                round(low, 2),
                round(high, 2),
                round(close, 2),
            ])
            p = close

        d += timedelta(days=1)

    return {"result": r}



